# ==============================================================================
# Nous Research Hermes Agent CLI - Konfigurasi External Client-API
# ==============================================================================

# Endpoint Base URL (mendukung official Nous API atau endpoint OpenAI-compatible)
HERMES_API_BASE_URL=https://api.nousresearch.com/v1

# Kunci otorisasi API
HERMES_API_KEY=your_api_key_here

# Nama model yang dituju
HERMES_MODEL=Hermes-3-Llama-3.1-8B

# Parameter inferensi Client
HERMES_TEMPERATURE=0.7
HERMES_MAX_TOKENS=2048
HERMES_TIMEOUT=60

# System prompt bawaan agent
HERMES_SYSTEM_PROMPT=You are Hermes, an autonomous and concise AI engineer and assistant.
